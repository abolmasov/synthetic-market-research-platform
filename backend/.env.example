PORT=3003
CORS_ORIGIN=http://localhost:5175

# JWT Authentication
JWT_SECRET=dev-secret-change-me-in-production
JWT_EXPIRES_IN=24h
ADMIN_BOOTSTRAP_KEY=
ADMIN_DEFAULT_EMAIL=
ADMIN_DEFAULT_PASSWORD=
ADMIN_DEFAULT_NAME=Platform Admin
ADMIN_DEFAULT_WORKSPACE_ID=

DB_HOST=127.0.0.1
DB_PORT=5445
DB_USER=smr
DB_PASSWORD=smr
DB_NAME=smr
DB_SYNC=false
DB_RUN_MIGRATIONS=false
DB_ENABLED=true

# Seeding
SEED_ENABLED=true

# LLM: mock (offline, default when GOOGLE_CLOUD_PROJECT is empty) or vertex (Gemini)
LLM_MODE=mock
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
VERTEX_AI_LOCATION=us-central1
GEMINI_MODEL=gemini-2.0-flash

# RAG Configuration
RAG_PROVIDER=inmemory              # 'inmemory' (demo sources) or 'pgvector' (needs DB + Vertex embeddings)
RAG_EMBEDDING_MODEL=text-embedding-005
RAG_TOP_K=10
RAG_CHUNK_SIZE=2000                # Characters per chunk
RAG_CHUNK_OVERLAP=200              # Overlap between chunks
RAG_MIN_RELEVANCE_SCORE=           # Optional: filter results below this score (0-1, e.g. 0.5)
RAG_BUCKET=                        # Optional object storage bucket name for document archives
